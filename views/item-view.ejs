<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title><%= item.title %> | Marketplace</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= BASE_PATH %>/style.css">

<style>
.thumb img {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
  cursor: pointer;
  border: 2px solid transparent;
}

.thumb img:hover {
  border-color: #0d6efd;
}

.main-img {
  width: 100%;
  max-height: 420px;
  object-fit: contain;
  border-radius: 12px;
}
</style>

</head>

<body>

<nav class="navbar navbar-dark bg-dark">
<div class="container">
<a class="navbar-brand" href="/">Marketplace</a>
</div>
</nav>

<div class="container py-4">

<div class="row g-4">

<!-- IMAGES -->
<div class="col-lg-7">

<div class="row">

<!-- Thumbnails -->
<div class="col-12 col-md-2 d-flex flex-md-column gap-2 mb-3 mb-md-0">

<% images.forEach(img => { %>
<div class="thumb">
<img src="<%= BASE_PATH + img.image_path %>" onclick="document.getElementById('mainImage').src=this.src">
</div>
<% }) %>

</div>

<!-- Main image -->
<div class="col-12 col-md-10">
<img id="mainImage" src="<%= BASE_PATH + images[0].image_path %>" class="main-img shadow-sm">
</div>

</div>

</div>

<!-- PRODUCT INFO -->
<div class="col-lg-5">

<h2 class="fw-bold"><%= item.title %></h2>

<p class="text-muted">
Category: <strong><%= item.category_name || "Uncategorised" %></strong>
</p>

<% if(item.status === 'sold'){ %>
<span class="badge bg-secondary">Sold</span>
<% } else { %>
<span class="badge bg-success">Available</span>
<% } %>

<h3 class="text-primary fw-bold mt-3">£<%= item.price %></h3>

<p class="mt-3"><%= item.description %></p>

<hr>

<p class="small text-muted">
Posted <%= new Date(item.created_at).toLocaleDateString() %>
</p>

<a href="/buyer" class="btn btn-outline-secondary w-100 mt-3">
Back to Marketplace
</a>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
