<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title><%= item.title %> | Marketplace</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= BASE_PATH %>/style.css">

<style>

/* Thumbnail images */
.thumb img {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
  cursor: pointer;
  border: 2px solid transparent;
}

.thumb img:hover {
  border-color: #0d6efd;
}

/* Main image frame */
.main-image-frame {
  width: 100%;
  height: 420px;
  background: #f5f5f5;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Main image */
.main-image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media(max-width:768px){
  .main-image-frame{
    height:300px;
  }
}

</style>

</head>

<body>

<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Marketplace</a>
  </div>
</nav>

<div class="container py-4">

<div class="row g-4">

<!-- IMAGE SECTION -->
<div class="col-lg-7">

<div class="row">

<!-- Thumbnails -->
<div class="col-12 col-md-2 d-flex flex-md-column gap-2 mb-3 mb-md-0">

<% images.forEach(img => { %>
<div class="thumb">
<img src="<%= BASE_PATH + img.image_path %>"
onclick="document.getElementById('mainImage').src=this.src">
</div>
<% }) %>

</div>

<!-- Main image -->
<div class="col-12 col-md-10">

<div class="main-image-frame shadow-sm">
<img id="mainImage" src="<%= BASE_PATH + images[0].image_path %>">
</div>

</div>

</div>

</div>

<!-- PRODUCT INFO -->
<div class="col-lg-5">

<h2 class="fw-bold"><%= item.title %></h2>

<p class="text-muted mb-1">
Category: <strong><%= item.category_name || "Uncategorised" %></strong>
</p>

<% if(item.status === 'sold'){ %>
<span class="badge bg-secondary mb-2">Sold</span>
<% } else { %>
<span class="badge bg-success mb-2">Available</span>
<% } %>

<h3 class="text-primary fw-bold mt-2">£<%= item.price %></h3>

<p class="mt-3"><%= item.description %></p>

<hr>

<p class="small text-muted">
Posted <%= new Date(item.created_at).toLocaleDateString() %>
</p>

<!-- ADD TO CART -->
<% if(item.status === 'approved'){ %>

<form method="POST" action="/cart/add/<%= item.id %>">
<button class="btn btn-dark w-100 mb-2">
Add to Cart
</button>
</form>

<% } %>

<a href="/buyer" class="btn btn-outline-secondary w-100">
Back to Marketplace
</a>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
