<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <title><%= item.title %> | Marketplace</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav class="navbar navbar-dark bg-dark">
  <div class="container d-flex justify-content-between align-items-center">
    <a class="navbar-brand" href="/">Marketplace</a>
    <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
  </div>
</nav>

<div class="container mt-5">

  <div class="row g-4">

    <!-- IMAGES -->
    <div class="col-md-6">

      <div class="card shadow-sm">

        <% if (images.length > 0) { %>

        <div id="itemCarousel" class="carousel slide">

          <div class="carousel-inner">

            <% images.forEach((img, index) => { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <div class="item-image-frame">
                  <img src="<%= BASE_PATH + img.image_path %>" class="card-img-top">
                </div>
              </div>
            <% }) %>

          </div>

          <% if (images.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#itemCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#itemCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon"></span>
            </button>
          <% } %>

        </div>

        <% } else { %>

        <div class="item-image-frame">
          <img src="/images/seller_cover.png" class="card-img-top">
        </div>

        <% } %>

      </div>

    </div>

    <!-- DETAILS -->
    <div class="col-md-6">

      <div class="card shadow-sm h-100">
        <div class="card-body">

          <h3 class="fw-bold"><%= item.title %></h3>

          <% if (item.status === 'sold') { %>
            <span class="badge bg-secondary">Sold</span>
          <% } else if (item.status === 'approved') { %>
            <span class="badge bg-success">Available</span>
          <% } else if (item.status === 'pending') { %>
            <span class="badge bg-warning text-dark">Pending</span>
          <% } else { %>
            <span class="badge bg-danger">Rejected</span>
          <% } %>

          <% if (item.status === 'sold') { %>
            <div class="alert alert-secondary mt-3">
              This item has been marked as sold.
            </div>
          <% } %>

          <div class="fs-3 fw-bold text-primary mt-3">
            £<%= item.price %>
          </div>

          <hr>

          <p class="text-muted">
            <%= item.description %>
          </p>

          <div class="small text-muted">
            Posted on <%= new Date(item.created_at).toLocaleDateString() %>
          </div>

          <hr>

          <h6 class="fw-bold">Contact Seller</h6>

          <ul class="list-unstyled small mb-0">

            <li class="mb-1">
              <strong>Email:</strong>
              <a href="mailto:<%= item.seller_email %>">
                <%= item.seller_email %>
              </a>
            </li>

            <% if (item.phone) { %>
              <li class="mb-1">
                <strong>Phone:</strong> <%= item.phone %>
              </li>
            <% } %>

            <% if (item.location) { %>
              <li>
                <strong>Location:</strong> <%= item.location %>
              </li>
            <% } %>

          </ul>

          <p class="text-muted small mt-2">
            Arrange payment and collection directly with the seller.
          </p>

          <a href="/buyer" class="btn btn-outline-secondary mt-3">
            ← Back to listings
          </a>

        </div>
      </div>

    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
