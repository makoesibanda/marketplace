<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Marketplace Settings | Admin</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark">
    <div class="container d-flex justify-content-between align-items-center">

      <a class="navbar-brand fw-bold" href="/admin">
        Marketplace Admin
      </a>

      <div class="d-flex gap-2">
        <a href="/admin" class="btn btn-secondary btn-sm">Dashboard</a>
        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>

    </div>
  </nav>

  <!-- MAIN -->
  <div class="container mt-4" style="max-width: 700px;">

    <h2 class="fw-bold mb-1">Marketplace Settings</h2>
    <p class="text-muted mb-4">
      Update the public name and description of the marketplace.
    </p>

    <!-- SUCCESS MESSAGE -->
    <% if (typeof success !== "undefined") { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <!-- SETTINGS FORM -->
    <form method="POST" action="/admin/settings">

      <div class="card shadow-sm mb-4">
        <div class="card-body">

          <!-- SITE NAME -->
          <div class="mb-3">
            <label class="form-label fw-semibold">
              Marketplace Name
            </label>
            <input
              type="text"
              name="site_name"
              class="form-control"
              value="<%= settings.site_name %>"
              required
            >
            <div class="form-text">
              This appears in the navbar, homepage, and browser title.
            </div>
          </div>

          <!-- SITE DESCRIPTION -->
          <div class="mb-3">
            <label class="form-label fw-semibold">
              Marketplace Description
            </label>
            <textarea
              name="site_description"
              class="form-control"
              rows="3"
              required
            ><%= settings.site_description %></textarea>
            <div class="form-text">
              Short description shown on the landing page.
            </div>
          </div>

        </div>
      </div>

      <!-- ACTIONS -->
      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
          Save Changes
        </button>
      </div>

    </form>

  </div>

</body>
</html>
