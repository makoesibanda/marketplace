<!DOCTYPE html>
<html>
<head>
  <title>Your Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-4">

<h3 class="mb-4">Your Cart</h3>

<% if(items.length === 0){ %>

  <p>Your cart is empty.</p>

  <a href="/buyer" class="btn btn-dark">Continue Shopping</a>

<% } else { %>

<table class="table bg-white shadow-sm">

<thead>
<tr>
  <th>Item</th>
  <th>Price</th>
  <th>Qty</th>
  <th>Total</th>
</tr>
</thead>

<tbody>

<% items.forEach(i => { %>

<tr>
  <td>
    <img src="<%= i.image %>" width="50" class="me-2">
    <%= i.title %>
  </td>

  <td>£<%= i.price %></td>

  <td><%= i.qty %></td>

  <td>£<%= (i.price * i.qty).toFixed(2) %></td>
</tr>

<% }) %>

</tbody>

</table>

<h5>Total: £<%= total.toFixed(2) %></h5>

<div class="mt-3">
  <a href="/buyer" class="btn btn-secondary">Continue Shopping</a>

  <a href="/checkout" class="btn btn-dark">Checkout</a>
</div>

<% } %>

</div>

</body>
</html>
