<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Your Cart | Marketplace</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= BASE_PATH %>/style.css">

<style>
.cart-img {
  width:60px;
  height:60px;
  object-fit:contain;
  border-radius:6px;
}
</style>
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">
<div class="container">
<a class="navbar-brand fw-bold" href="/">Marketplace</a>

<a href="/buyer" class="btn btn-outline-light btn-sm">
Back to Shop
</a>
</div>
</nav>

<div class="container py-4">

<h3 class="fw-bold mb-4">Your Cart</h3>

<% if(items.length === 0){ %>

<div class="card shadow-sm p-4 text-center">
<p class="text-muted">Your cart is empty.</p>

<a href="/buyer" class="btn btn-dark">
Continue Shopping
</a>
</div>

<% } else { %>

<!-- DESKTOP TABLE -->
<div class="d-none d-md-block">

<table class="table align-middle bg-white shadow-sm">

<thead class="table-light">
<tr>
<th>Item</th>
<th>Price</th>
<th>Qty</th>
<th>Total</th>
<th></th>
</tr>
</thead>

<tbody>

<% items.forEach(item => { %>

<tr>

<td>
<div class="d-flex align-items-center gap-2">
<img src="<%= BASE_PATH + item.image %>" class="cart-img">
<strong><%= item.title %></strong>
</div>
</td>

<td>£<%= item.price.toFixed(2) %></td>

<td>
<form method="POST" action="/cart/update/<%= item.id %>" class="d-flex gap-2">
<button name="action" value="decrease" class="btn btn-sm btn-outline-secondary">-</button>
<span class="fw-bold"><%= item.qty %></span>
<button name="action" value="increase" class="btn btn-sm btn-outline-secondary">+</button>
</form>
</td>

<td class="fw-bold">
£<%= (item.price * item.qty).toFixed(2) %>
</td>

<td>
<form method="POST" action="/cart/remove/<%= item.id %>">
<button class="btn btn-sm btn-danger">Remove</button>
</form>
</td>

</tr>

<% }) %>

</tbody>
</table>

</div>

<!-- MOBILE CARDS -->
<div class="d-md-none">

<% items.forEach(item => { %>

<div class="card shadow-sm mb-3">
<div class="card-body">

<div class="d-flex gap-3">

<img src="<%= BASE_PATH + item.image %>" class="cart-img">

<div class="flex-grow-1">

<h6 class="fw-bold mb-1"><%= item.title %></h6>

<p class="mb-1">£<%= item.price.toFixed(2) %></p>

<form method="POST" action="/cart/update/<%= item.id %>" class="d-flex align-items-center gap-2 mb-2">
<button name="action" value="decrease" class="btn btn-sm btn-outline-secondary">-</button>
<span><%= item.qty %></span>
<button name="action" value="increase" class="btn btn-sm btn-outline-secondary">+</button>
</form>

<p class="fw-bold">
Total £<%= (item.price * item.qty).toFixed(2) %>
</p>

<form method="POST" action="/cart/remove/<%= item.id %>">
<button class="btn btn-sm btn-danger w-100">
Remove
</button>
</form>

</div>

</div>

</div>
</div>

<% }) %>

</div>

<!-- TOTAL -->
<div class="card mt-4 shadow-sm">
<div class="card-body text-center">

<h4>Total: £<%= total.toFixed(2) %></h4>

<div class="d-grid gap-2 mt-3">

<a href="/buyer" class="btn btn-secondary">
Continue Shopping
</a>

<a href="/checkout" class="btn btn-success">
Proceed to Checkout
</a>

</div>

</div>
</div>

<% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
