<!DOCTYPE html>
<html>
<head>
<title>Your Cart</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">

<h2>Your Cart</h2>

<% if (items.length === 0) { %>

<p class="text-muted">Your cart is empty.</p>
<a href="/buyer" class="btn btn-dark">Continue Shopping</a>

<% } else { %>

<table class="table align-middle shadow-sm">

<thead>
<tr>
<th>Item</th>
<th>Price</th>
<th>Qty</th>
<th>Total</th>
<th></th>
</tr>
</thead>

<tbody>

<% items.forEach(item => { %>

<tr>

<td>
<div class="d-flex align-items-center gap-2">

 <img src="<%= BASE_PATH + item.image %>" width="50">

<strong><%= item.title %></strong>
</div>
</td>

<td>£<%= item.price.toFixed(2) %></td>

<td>

<form method="POST" action="/cart/update/<%= item.id %>" class="d-flex gap-2">

<button name="action" value="decrease" class="btn btn-sm btn-outline-secondary">−</button>

<span><%= item.qty %></span>

<button name="action" value="increase" class="btn btn-sm btn-outline-secondary">+</button>

</form>

</td>

<td>£<%= (item.price * item.qty).toFixed(2) %></td>

<td>
<form method="POST" action="/cart/remove/<%= item.id %>">
<button class="btn btn-sm btn-danger">Remove</button>
</form>
</td>

</tr>

<% }) %>

</tbody>

</table>

<h4>Total: £<%= total.toFixed(2) %></h4>

<div class="mt-3 d-flex gap-3">

<a href="/buyer" class="btn btn-secondary">Continue Shopping</a>
<a href="/checkout" class="btn btn-success w-100 mt-3">
Checkout
</a>

</div>

<% } %>

</body>
</html>
