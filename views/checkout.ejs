<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Checkout | Marketplace</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= BASE_PATH %>/style.css">
</head>

<body class="bg-light">

<!-- NAVBAR -->
<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      Marketplace
    </a>

    <a href="/cart" class="btn btn-outline-light btn-sm">
      Back to Cart
    </a>
  </div>
</nav>

<div class="container py-4">

<h3 class="fw-bold mb-4">Checkout</h3>

<!-- ORDER SUMMARY -->
<div class="card shadow-sm mb-4">
<div class="card-body">

<h5 class="fw-bold mb-3">Order Summary</h5>

<div class="table-responsive">
<table class="table align-middle">

<thead class="table-light">
<tr>
<th>Item</th>
<th>Qty</th>
<th>Total</th>
</tr>
</thead>

<tbody>
<% items.forEach(i => { %>
<tr>
<td><%= i.title %></td>
<td><%= i.qty %></td>
<td>£<%= (i.price * i.qty).toFixed(2) %></td>
</tr>
<% }) %>
</tbody>

</table>
</div>

<div class="text-end fw-bold fs-5">
Total: £<%= total.toFixed(2) %>
</div>

</div>
</div>

<!-- DELIVERY DETAILS -->
<div class="card shadow-sm">
<div class="card-body">

<h5 class="fw-bold mb-3">Delivery Information</h5>

<form method="POST" action="/checkout/pay">

<div class="row g-3">

<div class="col-md-6">
<label class="form-label">Full Name</label>
<input name="full_name" class="form-control" required>
</div>

<div class="col-md-6">
<label class="form-label">Phone</label>
<input name="phone" class="form-control" required>
</div>

<div class="col-12">
<label class="form-label">Address</label>
<input name="address" class="form-control" required>
</div>

<div class="col-md-6">
<label class="form-label">City</label>
<input name="city" class="form-control" required>
</div>

<div class="col-md-6">
<label class="form-label">Postcode</label>
<input name="postcode" class="form-control" required>
</div>

</div>

<hr class="my-4">

<button class="btn btn-success w-100 btn-lg">
Confirm & Pay
</button>

</form>

</div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
