<h2>Forgot Password</h2>

<form method="POST">
  <input name="email" type="email" placeholder="Enter your email" required>
  <button>Send Reset Link</button>
</form>

<% if (error) { %>
<p style="color:red"><%= error %></p>
<% } %>

<% if (success) { %>
<p style="color:green"><%= success %></p>
<% } %>
