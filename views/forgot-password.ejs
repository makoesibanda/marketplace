<!DOCTYPE html>
<html>
<head>
  <title>Forgot Password</title>

  <style>
    body {
      font-family: Arial;
      background: #f5f5f5;
    }

    .auth-box {
      max-width: 400px;
      margin: 100px auto;
      padding: 30px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 15px rgba(0,0,0,.1);
      text-align: center;
    }

    input {
      width: 100%;
      padding: 10px;
      margin: 15px 0;
    }

    button {
      padding: 10px 20px;
      background: black;
      color: white;
      border: none;
      cursor: pointer;
      width: 100%;
    }

    .error {
      color: red;
      margin-top: 15px;
    }

    .success {
      color: green;
      margin-top: 15px;
    }
  </style>
</head>

<body>

<% error = error || null; %>
<% success = success || null; %>

<div class="auth-box">

<h2>Forgot Password</h2>

<form method="POST">

  <input name="email" type="email" placeholder="Enter your email" required>

  <button>Send Reset Link</button>

</form>

<% if (error) { %>
<p class="error"><%= error %></p>
<% } %>

<% if (success) { %>
<p class="success"><%= success %></p>
<% } %>

</div>

</body>
</html>
