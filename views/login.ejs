<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <!-- Page title -->
  <title>Login | Marketplace</title>

  <!-- Bootstrap CSS for layout and styling -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom application styles -->
  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <!--
    NAVIGATION BAR
    Minimal header with brand link back to homepage
  -->
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        Marketplace
      </a>
    </div>
  </nav>

  <!--
    LOGIN FORM CONTAINER
    Centered, narrow layout to keep focus on authentication
  -->
  <div class="container mt-5" style="max-width: 400px;">

    <!-- Page heading -->
    <h2 class="mb-4 text-center">
      Login
    </h2>

    <!--
      Error feedback
      Displayed only when the server passes an error message
    -->
    <% if (typeof error !== "undefined") { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
    <% } %>

    <!--
      LOGIN FORM
      Submits credentials securely via POST
    -->
    <form method="POST" action="/login">

      <!-- Email input -->
      <div class="mb-3">
        <label class="form-label">
          Email address
        </label>
        <input
          type="email"
          name="email"
          class="form-control"
          required
        >
      </div>

      <!-- Password input -->
      <div class="mb-3">
        <label class="form-label">
          Password
        </label>
        <input
          type="password"
          name="password"
          class="form-control"
          required
        >
      </div>

      <!-- Submit button -->
      <button type="submit" class="btn btn-primary w-100">
        Login
      </button>

    </form>

    <!-- Registration redirect -->
    <p class="mt-3 text-center">
      Don’t have an account?
      <a href="/register">Register</a>
    </p>

  </div>

</body>
</html>
