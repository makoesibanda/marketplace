<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

  <!-- Page title -->
  <title>Register | Marketplace</title>

  <!-- Bootstrap CSS for layout and components -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Custom application styles -->
  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <!--
    NAVIGATION BAR
    Simple header with a link back to the homepage
  -->
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">
        Marketplace
      </a>
    </div>
  </nav>

  <!--
    REGISTRATION CONTAINER
    Centered layout to keep focus on account creation
  -->
  <div class="container mt-5" style="max-width: 480px;">

    <!-- Page heading -->
    <h2 class="mb-4 text-center">
      Create Account
    </h2>

    <!--
      Error feedback
      Displayed when validation or server-side checks fail
    -->
    <% if (typeof error !== "undefined") { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
    <% } %>

    <!--
      Success feedback
      Shown after successful registration
    -->
    <% if (typeof success !== "undefined") { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <!--
      REGISTRATION FORM
      Submits user details to the server via POST
    -->
    <form method="POST" action="/register">

      <!-- Full name input -->
      <div class="mb-3">
        <label class="form-label">
          Full name
        </label>
        <input
          type="text"
          name="full_name"
          class="form-control"
          value="<%= formData?.full_name || '' %>"
          required
        >
      </div>

      <!-- Email input -->
      <div class="mb-3">
        <label class="form-label">
          Email address
        </label>
        <input
          type="email"
          name="email"
          class="form-control"
          value="<%= formData?.email || '' %>"
          required
        >
      </div>

      <!-- Password input -->
      <div class="mb-3">
        <label class="form-label">
          Password
        </label>
        <input
          type="password"
          name="password"
          class="form-control"
          required
        >
      </div>

      <!-- Password confirmation -->
      <div class="mb-3">
        <label class="form-label">
          Confirm password
        </label>
        <input
          type="password"
          name="confirm_password"
          class="form-control"
          required
        >
      </div>

      <!-- Submit button -->
      <button type="submit" class="btn btn-success w-100">
        Register
      </button>

    </form>

    <!-- Redirect to login page -->
    <p class="mt-3 text-center">
      Already have an account?
      <a href="/login">Login</a>
    </p>

  </div>

</body>
</html>
